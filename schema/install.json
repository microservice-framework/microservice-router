{
  "properties": {
    "mongo_url": {
      "type": "string",
      "description": "Mongo URL",
      "default": "mongodb://localhost:27017/",
      "required": true
    },
    "mongo_table": {
      "type": "string",
      "description": "Mongo Table",
      "default": "routes",
      "required": true
    },
    "mongo_db": {
      "type": "string",
      "description": "Mongo prefix(db)",
      "default": "mfw"
    },
    "port": {
      "type": "number",
      "description": "Admin port",
      "default": 3000,
      "required": true
    },
    "proxy_port": {
      "type": "number",
      "description": "Proxy port",
      "default": 3100,
      "required": true
    },
    "workers": {
      "type": "number",
      "description": "Number of workers",
      "default": 2,
      "required": true
    },
    "interval": {
      "type": "number",
      "description": "How often to clean expired services.",
      "default": 30000,
      "required": true
    },
    "template_path": {
      "type": "string",
      "description": "Path to API exloper HTML templates.",
      "default": "./dist"
    },
    "self_path": {
      "type": "string",
      "description": "SELF PATH",
      "default": "register",
      "required": true
    },
    "self_url": {
      "type": "string",
      "description": "SELF URL",
      "default": "http://localhost:3000/",
      "required": true
    },
    "router_url": {
      "type": "string",
      "description": "ROUTER URL ",
      "default": "http://localhost:3000",
      "required": true
    },
    "router_proxy_url": {
      "type": "string",
      "description": "ROUTER PROXY URL ",
      "default": "http://localhost:3100",
      "required": true
    },
    "router_secret": {
      "type": "string",
      "description": "ROUTER SECRET. Take it from microservice-router settings.",
      "default": "",
      "required": true
    },
    "router_period": {
      "type": "number",
      "description": "How often report to router (ms)",
      "default": 3000,
      "required": true
    },
    "scope": {
      "type": "string",
      "description": "Path to API exloper HTML templates.",
      "default": "register"
    },
    "schema": {
      "type": "string",
      "description": "Do not change",
      "default": "service.json",
      "required": true
    },
    "proxypidfile": {
      "type": "string",
      "description": "proxy pid file",
      "default": "../../pids/microservice-proxy.pid",
      "required": true
    },
    "proxylogfile": {
      "type": "string",
      "description": "proxy log file",
      "default": "../../logs/microservice-proxy.log",
      "required": true
    }
  }
}
